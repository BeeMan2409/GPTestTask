<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="you">
        <createTable tableName="hotel">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="brand" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="post_code" type="VARCHAR(20)"/>
            <column name="house_num" type="VARCHAR(20)"/>
            <column name="street" type="VARCHAR(255)"/>
            <column name="adress" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="you">
        <createTable tableName="hotel_amenities">
            <column name="hotel_id" type="INT">
                <constraints nullable="false"
                             foreignKeyName="fk_amenities_hotel"
                             referencedTableName="hotel"
                             referencedColumnNames="id"/>
            </column>
            <column name="amenity" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="you">
        <addColumn tableName="hotel">
            <column name="arival_time" type="VARCHAR ARRAY"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>